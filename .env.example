# Optional GitHub personal access token (fine-grained tokens need Pull requests: Read).
GITHUB_TOKEN=

# Optional OpenAI-compatible chat completions API credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional HTTP Basic Auth protection. Set both values to enable.
# Recommended when exposing the demo through a public link.
CODE_SENTINEL_USERNAME=
CODE_SENTINEL_PASSWORD=

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Server bind address and local port. Hosted platforms can override PORT.
HOST=0.0.0.0
PORT=8000
